{
  "name": "frederiks-castle-defense",
  "version": "2.0.0-prototype",
  "private": true,
  "description": "An original, buildless HTML5 Canvas game for Frederik",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.mjs",
    "build:native": "node scripts/build-native.mjs",
    "android:add": "npm run build:native && cap add android",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "test:browser": "python3 tests/browser-saves.py && python3 tests/browser-prototype.py"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.27.7"
  }
}
